<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <handlers>
      <add name="PythonHandler"
           path="*"
           verb="*"
           modules="httpPlatformHandler"
           resourceType="Unspecified"/>
    </handlers>
    <httpPlatform processPath="D:\plannerFD\calculation_service\venv\Scripts\python.exe"
                  arguments="-m uvicorn app.main:app --port %HTTP_PLATFORM_PORT%"
                  stdoutLogEnabled="true"
                  stdoutLogFile="D:\plannerFD\calculation_service\logs\iis.log"
                  startupTimeLimit="60"
                  requestTimeout="00:04:00">
      <environmentVariables>
        <environmentVariable name="PYTHONPATH"
                             value="D:\plannerFD\calculation_service"/>
      </environmentVariables>
    </httpPlatform>
  </system.webServer>
</configuration>